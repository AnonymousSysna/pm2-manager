# Client build/dev configuration. Copy to the file for the mode you need:
#   .env.development  used by `npm run dev`
#   .env.production   used by `npm run build`
# Vite only exposes variables prefixed with VITE_ to the browser. Never put
# secrets here: anything in these files ships in the bundle.
#
# Vite loads .env, then .env.[mode], then .env.[mode].local, then .env.local,
# with real shell/CI variables always winning. Only VITE_-prefixed names reach
# the app.

# Base URL for API and socket connections. Leave empty when the dashboard is
# served from the same origin as the API (the default single-port deploy).
VITE_API_URL=

# Milliseconds before a normal API request is considered stuck. Long operations
# (deploy, npm install/build, git pull, PM2/caddy/jcode installs) always get 5
# minutes regardless of this value.
VITE_API_TIMEOUT_MS=

# Client-side crash reporting to POST /api/v1/client-errors.
# on  = report (default in production builds)
# off = never report (default in dev, useful for noisy local debugging)
VITE_ERROR_REPORTING=

# Shown next to crash reports so the server log can be tied to a release.
VITE_APP_VERSION=
