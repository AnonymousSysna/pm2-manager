{
  "name": "pm2-dashboard",
  "version": "1.0.29",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "node ./scripts/build-client-clean.js",
    "start": "npm --prefix server run start",
    "onetap": "node ./scripts/onetap.js",
    "typecheck": "npm --prefix client run typecheck && npm --prefix server run typecheck",
    "pm2:start": "node ./scripts/pm2-local.js start",
    "pm2:stop": "node ./scripts/pm2-local.js stop",
    "pm2:restart": "node ./scripts/pm2-local.js restart",
    "pm2:logs": "node ./scripts/pm2-local.js logs",
    "pm2:save": "node ./scripts/pm2-local.js save",
    "deploy": "npm run build && npm run pm2:start",
    "onetap:linux": "node ./scripts/onetap.js",
    "onetap:windows": "node ./scripts/onetap.js",
    "test:installer": "node scripts/onetap.test.js",
    "preflight": "npm --prefix server run preflight",
    "verify": "npm run typecheck && npm --prefix server test && npm --prefix client test",
    "pm2:status": "node ./scripts/pm2-local.js status",
    "env:bootstrap": "node ./scripts/env-bootstrap.js",
    "setup": "node ./scripts/npm-safe-install.js all",
    "repair:env": "node ./scripts/env-bootstrap.js",
    "setup:dev": "node ./scripts/npm-safe-install.js all --include-root",
    "setup:clean": "node ./scripts/npm-safe-install.js all --clean",
    "repair:npm": "node ./scripts/npm-safe-install.js all --clean --verify-cache",
    "build:client": "node ./scripts/build-client-clean.js",
    "build:client:raw": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
